# Xcode project is generated by XcodeGen from project.yml — never hand-edited,
# never committed. Run Scripts/bootstrap.sh (or `xcodegen generate`) to produce it.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
.build/
*.swiftpm/xcuserdata/

# Swift Package Manager
.swiftpm/
Package.resolved

# macOS
.DS_Store
.AppleDouble
.LSOverride

# CocoaPods / Carthage (if ever used)
Pods/
Carthage/Build/

# Logs & local env
*.log
.env
.env.*
!.env.example

# Local agent / editor integrations (may contain paths or credentials)
/.agents/
/.codex/
/.mcp.json
/.xcodebuildmcp/

# Private keys, local signing identities and provisioning files
*.key
*.pem
*.p12
*.pfx
*.keychain
*.keychain-db
*.mobileprovision
*.provisionprofile
id_rsa
id_ed25519

# Build output
build/
dist/
*.ipa
*.dSYM.zip
*.dSYM
